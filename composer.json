{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "dsolodev/wirekit",
  "type": "project",
  "description": "A very opinionated starter kit for Laravel with Filament as the admin panel.",
  "keywords": [
    "laravel",
    "filament",
    "starter kit"
  ],
  "license": "MIT",
  "repositories": [
    {
      "type": "composer",
      "url": "https://packages.filamentphp.com/composer"
    }
  ],
  "require": {
    "php": "^8.5",
    "bezhansalleh/filament-shield": "^4.3",
    "filament/filament": "^5.6.8",
    "laravel/framework": "^13.19.0",
    "laravel/tinker": "^3.0.2",
    "opcodesio/log-viewer": "^3.24"
  },
  "require-dev": {
    "driftingly/rector-laravel": "^2.5",
    "fakerphp/faker": "^1.24.1",
    "filament/blueprint": "^2.2",
    "larastan/larastan": "^3.10.0",
    "laravel/boost": "^2.4.12",
    "laravel/pail": "^1.2.7",
    "laravel/pint": "^1.29.3",
    "mockery/mockery": "^1.6.12",
    "nunomaduro/collision": "^8.9.4",
    "pestphp/pest": "^4.7.5",
    "pestphp/pest-plugin-laravel": "^4.1",
    "pestphp/pest-plugin-livewire": "^4.1",
    "pestphp/pest-plugin-type-coverage": "^4.0.4",
    "rector/rector": "^2.5.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "setup": [
      "composer install",
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php artisan wirekit:install",
      "npm install",
      "npm run build"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi",
      "@php artisan filament:upgrade"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
      "@php artisan boost:update --ansi"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan wirekit:install --ansi"
    ],
    "pre-package-uninstall": [
      "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
    ],
    "update:requirements": [
      "composer bump",
      "npm run ncu"
    ],
    "lint": [
      "rector",
      "pint --parallel",
      "npm run lint"
    ],
    "test:lint": [
      "pint --parallel --test",
      "rector --dry-run",
      "npm run test:lint"
    ],
    "test:types": "phpstan",
    "test:type-coverage": "pest --type-coverage --min=100",
    "test:unit": "@php artisan test --compact",
    "test": [
      "@test:lint",
      "@test:types",
      "@test:type-coverage",
      "@test:unit"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
